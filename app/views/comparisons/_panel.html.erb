<%# The comparison panel. Rendered into the page by create, then re-rendered
    by show each time the frame polls, until the job finishes. %>
<% polling = !(comparison.done? || comparison.failed?) %>

<%= turbo_frame_tag "comparison_panel" do %>
  <%= tag.section class: "mt-12 rounded-2xl border border-slate-700 bg-slate-900/60 p-6",
                  data: (polling ? { controller: "poll", poll_url_value: comparison_path(id) } : {}) do %>

    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-semibold"><%= t("comparisons.panel.heading") %></h2>

      <% if comparison.done? %>
        <%# data: { turbo: false } so the browser handles this as a normal
            download instead of Turbo trying to visit/render the response. %>
        <%= link_to pdf_comparison_path(id),
              data: { turbo: false },
              class: "flex items-center gap-2 rounded-full border border-slate-700 px-4 py-2 text-sm text-slate-300 transition hover:border-violet-500 hover:text-slate-100" do %>
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M12 4v10m0 0-3.5-3.5M12 14l3.5-3.5M5 18h14" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <%= t("comparisons.panel.download") %>
        <% end %>
      <% end %>
    </div>

    <% if comparison.failed? %>
      <p class="mt-6 text-rose-400">
        <%= comparison.error.presence || t("comparisons.panel.failed_generic") %>
      </p>

    <% elsif polling %>
      <div class="mt-8 flex items-center gap-3 text-slate-400">
        <span class="h-5 w-5 shrink-0 animate-spin rounded-full border-2 border-slate-600 border-t-cyan-400" aria-hidden="true"></span>
        <div>
          <p><%= t("comparisons.panel.phases.#{comparison.phase}") %></p>
          <% if comparison.phase == :comparing %>
            <p class="text-sm text-slate-500"><%= comparison_tally(comparison) %></p>
          <% end %>
        </div>
      </div>

      <%# Pre-guardrail: rows and cells are exactly what the model has recorded
          so far, so this can only grow or be replaced on the next poll — never
          treat it as the final table. %>
      <% if comparison.rows.any? %>
        <%= render "table", comparison: comparison %>
      <% end %>

      <% if comparison.discrepancies? %>
        <%= render "discrepancies", comparison: comparison %>
      <% end %>

    <% else %>
      <%= render "table", comparison: comparison %>

      <% if comparison.discrepancies? %>
        <%= render "discrepancies", comparison: comparison %>
      <% end %>

      <% if comparison.recommendation.present? %>
        <h3 class="mt-8 text-lg font-semibold"><%= t("comparisons.panel.recommendation") %></h3>
        <p class="mt-2 text-slate-300"><%= comparison.recommendation %></p>
      <% end %>
    <% end %>
  <% end %>
<% end %>
