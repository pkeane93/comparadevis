<%# The comparison panel. Rendered into the page by create, then re-rendered
    by show each time the frame polls, until the job finishes. %>
<% polling = !(comparison.done? || comparison.failed?) %>

<%= turbo_frame_tag "comparison_panel" do %>
  <%= tag.section class: "mt-12 rounded-2xl border border-slate-700 bg-slate-900/60 p-6",
                  data: (polling ? { controller: "poll", poll_url_value: comparison_path(id) } : {}) do %>

    <h2 class="text-2xl font-semibold">Comparison</h2>

    <% if comparison.failed? %>
      <p class="mt-6 text-rose-400">
        <%= comparison.error.presence || "Something went wrong while comparing these quotes." %>
      </p>

    <% elsif polling %>
      <div class="mt-8 flex items-center justify-center gap-3 py-10 text-slate-400">
        <span class="h-5 w-5 animate-spin rounded-full border-2 border-slate-600 border-t-cyan-400" aria-hidden="true"></span>
        Reading the quotes — this takes 30 to 60 seconds.
      </div>

    <% else %>
      <div class="mt-6 overflow-x-auto">
        <%# Tailwind cannot size a class by quote count, and without a floor the
            browser squeezes six columns instead of letting the box scroll. %>
        <table class="w-full border-collapse text-left"
               style="min-width: <%= (comparison.quotes.size + 1) * 150 %>px">
          <thead>
            <tr class="border-b border-slate-700 text-slate-400">
              <th class="py-2 pr-4 font-normal"></th>
              <% comparison.quotes.each do |quote| %>
                <th class="py-2 pr-4 font-normal"><%= quote.label %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% comparison.rows.each do |row| %>
              <tr class="border-b border-slate-800">
                <td class="py-2 pr-4 text-slate-400">
                  <%= row[:line_item] %>
                  <% if row[:note].present? %>
                    <span class="block text-xs text-slate-600"><%= row[:note] %></span>
                  <% end %>
                </td>
                <% row[:cells].each do |cell| %>
                  <td class="py-2 pr-4">
                    <% if cell[:verified] %>
                      <%= cell[:value] %>
                    <% else %>
                      <span class="text-amber-400/70 italic">needs checking</span>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if comparison.discrepancies? %>
        <h3 class="mt-8 text-lg font-semibold">
          Discrepancies
          <span class="ml-2 rounded-full bg-cyan-400/15 px-3 py-1 text-sm text-cyan-300">
            <%= comparison.discrepancies.size %>
          </span>
        </h3>
        <ul class="mt-3 space-y-2">
          <% comparison.discrepancies.each do |discrepancy| %>
            <li class="flex gap-3">
              <span class="mt-1 h-2 w-2 shrink-0 rounded-full <%= discrepancy[:severity] == :high ? "bg-rose-400" : "bg-slate-500" %>"></span>
              <%= discrepancy[:description] %>
            </li>
          <% end %>
        </ul>
      <% end %>

      <% if comparison.recommendation.present? %>
        <h3 class="mt-8 text-lg font-semibold">Recommendation</h3>
        <p class="mt-2 text-slate-300"><%= comparison.recommendation %></p>
      <% end %>
    <% end %>
  <% end %>
<% end %>
