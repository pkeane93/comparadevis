<div class="mx-auto max-w-5xl px-4 pt-6 pb-16"
     data-controller="uploads"
     data-uploads-max-value="<%= @max_quotes %>"
     data-uploads-min-value="<%= @min_quotes %>"
     data-uploads-hint-value="<%= t("comparisons.quote_field.hint") %>"
     data-uploads-quote-label-value="<%= t("comparisons.quote_field.quote_title", index: "%{n}") %>">
  <header class="flex items-center justify-between rounded-2xl border border-slate-700 bg-gradient-to-r from-violet-950 to-cyan-950 px-6 py-4">
    <span class="flex items-center gap-3 text-xl font-semibold">
      <span class="h-5 w-5 rotate-45 rounded-md border-2 border-cyan-400" aria-hidden="true"></span>
      Comparadevis
    </span>

    <nav class="flex items-center gap-3 text-sm" aria-label="Language">
      <% %w[en fr nl].each do |locale| %>
        <%= link_to locale.upcase, root_path(locale: locale == "en" ? nil : locale),
              class: "transition #{I18n.locale.to_s == locale ? "text-slate-100" : "text-slate-500 hover:text-slate-300"}" %>
      <% end %>
    </nav>
  </header>

  <section class="mx-auto mt-10 max-w-5xl text-center">
    <div class="mx-auto max-w-3xl">
      <p class="text-lg text-slate-200">
        <%= t("comparisons.explainer.intro") %>
      </p>
      <p class="mt-2 text-sm text-slate-500">
        <%= t("comparisons.explainer.audience") %>
      </p>
    </div>

    <div class="mt-8 grid grid-cols-3 gap-6">
      <div class="flex flex-col items-center rounded-2xl border border-slate-700 bg-slate-900/60 p-5 text-center">
        <%= image_tag "step-1.png", class: "h-32 w-32 rounded-xl object-cover bg-slate-800", alt: "" %>
        <p class="mt-4 font-semibold"><%= t("comparisons.steps.upload.title") %></p>
        <p class="mt-1 text-sm text-slate-400"><%= t("comparisons.steps.upload.subtitle") %></p>
      </div>
      <div class="flex flex-col items-center rounded-2xl border border-slate-700 bg-slate-900/60 p-5 text-center">
        <%= image_tag "step-2.png", class: "h-32 w-32 rounded-xl object-cover bg-slate-800", alt: "" %>
        <p class="mt-4 font-semibold"><%= t("comparisons.steps.agent.title") %></p>
        <p class="mt-1 text-sm text-slate-400"><%= t("comparisons.steps.agent.subtitle") %></p>
      </div>
      <div class="flex flex-col items-center rounded-2xl border border-slate-700 bg-slate-900/60 p-5 text-center">
        <%= image_tag "step-3.png", class: "h-32 w-32 rounded-xl object-cover bg-slate-800", alt: "" %>
        <p class="mt-4 font-semibold"><%= t("comparisons.steps.result.title") %></p>
        <p class="mt-1 text-sm text-slate-400"><%= t("comparisons.steps.result.subtitle") %></p>
      </div>
    </div>
  </section>

  <%= form_with url: comparisons_path, multipart: true, class: "mt-12",
                data: { uploads_target: "form", action: "submit->uploads#onSubmit" } do |form| %>

    <% if @error.present? %>
      <p role="alert" class="mx-auto mb-5 max-w-xl rounded-xl border border-rose-900 bg-rose-950/60 px-4 py-3 text-center">
        <%= @error %>
      </p>
    <% end %>

    <div class="flex flex-wrap justify-center gap-6" data-uploads-target="zones">
      <%= render "quote_field", index: 1 %>
      <%= render "quote_field", index: 2 %>

      <button type="button"
              data-uploads-target="add"
              data-action="uploads#add"
              class="flex max-w-sm flex-1 basis-64 flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-slate-700 bg-transparent px-6 py-10 text-center text-slate-400 transition hover:border-violet-500 hover:text-slate-100">
        <svg class="h-11 w-11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M12 5v14M5 12h14" stroke-linecap="round" />
        </svg>
        <span class="text-xl"><%= t("comparisons.add_another_quote") %></span>
      </button>
    </div>

    <div class="mx-auto mt-7 max-w-xl">
      <%= form.label :description, t("comparisons.description_label"), class: "block text-sm text-slate-400" %>
      <%= form.text_field :description,
            value: params[:description],
            placeholder: t("comparisons.description_placeholder"),
            class: "mt-2 w-full rounded-xl border border-slate-700 bg-slate-900/60 px-4 py-2.5 placeholder:text-slate-600 focus:border-violet-500 focus:outline-none" %>
    </div>

    <div class="mt-7 flex items-center justify-center gap-4">
      <%= form.submit t("comparisons.compare"),
            data: { uploads_target: "submit" },
            class: "cursor-pointer rounded-full bg-gradient-to-r from-violet-500 to-cyan-400 px-6 py-2.5 font-semibold text-slate-950" %>

      <button type="button"
              hidden
              data-uploads-target="reset"
              data-action="uploads#reset"
              class="cursor-pointer rounded-full border border-slate-700 px-6 py-2.5 font-semibold text-slate-300 transition hover:border-violet-500 hover:text-slate-100">
        <%= t("comparisons.reset") %>
      </button>
    </div>

    <p id="attempts_left" class="mt-3 text-center text-sm text-slate-500">
      <%= t("comparisons.attempts_left", count: @attempts_left) %>
    </p>
  <% end %>

  <%# The comparison panel is appended here by create.turbo_stream.erb %>
  <div id="comparison" data-uploads-target="panel"></div>

  <footer class="mt-16 text-center text-sm text-slate-500">
    <%= t("comparisons.footer.built_by") %>
    <%= link_to "Cathan Studio", "https://cathan-studio.sliplane.app/",
          class: "text-slate-400 underline decoration-slate-700 underline-offset-4 transition hover:text-violet-400",
          target: "_blank", rel: "noopener" %>
  </footer>
</div>
