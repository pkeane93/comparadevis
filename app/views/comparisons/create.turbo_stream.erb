<%# Drops the panel under the upload zones without leaving the page. %>
<%= turbo_stream.update "comparison" do %>
  <%= render "panel", comparison: @comparison, id: @id %>
<% end %>

<%# The rate limit is consumed by this request, so the counter shown on the
    page (rendered before the request) is now stale — refresh it too. %>
<%= turbo_stream.update "attempts_left" do %>
  <%= t("comparisons.attempts_left", count: @attempts_left) %>
<% end %>
