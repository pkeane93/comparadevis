<label data-uploads-target="zone"
       class="relative flex max-w-sm flex-1 basis-64 cursor-pointer flex-col items-center gap-2 rounded-2xl border-2 border-dashed border-slate-700 bg-slate-900/60 px-6 py-10 text-center transition hover:border-violet-500 focus-within:border-violet-500">
  <%# The file input must come before the remove button in the DOM — a label's
      implicit control is the first labelable descendant, and a <button> is
      labelable too, so ordering it first would make the label activate the
      remove button instead of opening the file picker. %>
  <input type="file"
         name="quotes[]"
         accept="application/pdf"
         class="sr-only"
         data-action="uploads#pick">

  <button type="button"
          data-uploads-target="remove"
          data-action="click->uploads#remove"
          hidden
          class="absolute right-3 top-3 rounded-full p-1.5 text-slate-500 transition hover:bg-slate-800 hover:text-rose-400"
          aria-label="<%= t("comparisons.quote_field.remove") %>">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M4 7h16M9 7V4.5A1.5 1.5 0 0 1 10.5 3h3A1.5 1.5 0 0 1 15 4.5V7m2 0-.8 12.2A2 2 0 0 1 14.2 21H9.8a2 2 0 0 1-2-1.8L7 7"
            stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>

  <svg class="h-11 w-11 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    <path d="M12 16V7m0 0L8.5 10.5M12 7l3.5 3.5" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M4 15a4.5 4.5 0 0 1 1.6-8.7A5.5 5.5 0 0 1 16.4 7 4 4 0 0 1 20 15" stroke-linecap="round" stroke-linejoin="round" />
  </svg>

  <span class="text-xl" data-uploads-target="title"><%= t("comparisons.quote_field.quote_title", index: index) %></span>
  <span class="text-sm break-all text-slate-500" data-uploads-target="hint"><%= t("comparisons.quote_field.hint") %></span>
</label>
